PORT=3000

# ── Database (PostgreSQL / Neon DB) ──────────────────────────────────────────
# Local Docker:  DB_HOST=localhost
# Neon (direct): DB_HOST=ep-<your-project>.c-2.ap-southeast-1.aws.neon.tech
# Neon (pooler): DB_HOST=ep-<your-project>-pooler.c-2.ap-southeast-1.aws.neon.tech
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=localdev
DB_NAME=FLIGHTS
DB_DIALECT=postgres
# Set to "true" for Neon DB or any TLS-enforcing PostgreSQL host
DB_SSL=false

# ── Message Queue ─────────────────────────────────────────────────────────────
RABBITMQ_URL=amqp://localhost

# ── Redis (search result cache) ───────────────────────────────────────────────
# Use REDIS_URL for managed Redis (e.g. Upstash), or REDIS_HOST+REDIS_PORT for local.
# REDIS_URL=redis://default:password@host:port
REDIS_HOST=localhost
REDIS_PORT=6379
