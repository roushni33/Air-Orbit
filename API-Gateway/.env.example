PORT=5000

# ── Database (PostgreSQL / Neon DB) ──────────────────────────────────────────
# Local Docker:  DB_HOST=localhost
# Neon (direct): DB_HOST=ep-autumn-paper-aod209j6.c-2.ap-southeast-1.aws.neon.tech
# Neon (pooler): DB_HOST=ep-autumn-paper-aod209j6-pooler.c-2.ap-southeast-1.aws.neon.tech
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=localdev
DB_NAME=auth_db
DB_DIALECT=postgres
# Set to "true" for Neon DB or any TLS-enforcing PostgreSQL host
DB_SSL=false

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRY=24h
SALT_ROUNDS=10

# Set to your Vercel frontend URL in production to restrict CORS
ALLOWED_ORIGIN=http://localhost:5173

# ── Downstream services ───────────────────────────────────────────────────────
FLIGHTS_SERVICE=http://localhost:3000
BOOKING_SERVICE=http://localhost:4000

# ── Redis (rate-limiting / token blacklist) ───────────────────────────────────
# Use REDIS_URL for managed Redis (e.g. Upstash), or REDIS_HOST+REDIS_PORT for local.
# REDIS_URL=redis://default:password@host:port
REDIS_HOST=localhost
REDIS_PORT=6379
